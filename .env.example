SUPABASE_URL=your_supabase_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
SMARTLEAD_API_KEY=your_smartlead_api_key_here
WEBHOOK_BASE_URL=https://yourapp.com  # ngrok URL for dev
MILLIONVERIFIER_API_KEY=your_millionverifier_api_key_here

# ── Provisioning (SmartSenders) ───────────────────────────────────────────
# Set PROVISIONING_MOCK=true to dry-run mailbox provisioning without spending money.
# The wrapper fakes vendor list + place-order, the poller completes the order after
# PROVISIONING_MOCK_DELAY_MS, and creates real senders rows with mock SMTP details.
# Use PROVISIONING_POLL_SCHEDULE to speed up the poll cadence during dev.
PROVISIONING_MOCK=false
PROVISIONING_MOCK_DELAY_MS=60000
# PROVISIONING_POLL_SCHEDULE=*/30 * * * * *  # every 30s for dev
# SMARTSENDERS_API_KEY=  # optional override; otherwise falls back to SMARTLEAD_API_KEY
