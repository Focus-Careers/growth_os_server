SUPABASE_URL=your_supabase_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Model traffic goes through Vercel AI Gateway. Only the key is required; model names default in
# src/config/models.js and carry a provider prefix ("openai/...") the gateway routes on.
AI_GATEWAY_API_KEY=your_ai_gateway_api_key_here
# AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1
# MODEL_FAST=openai/gpt-6-luna
# MODEL_STANDARD=openai/gpt-6.1-terra
# MODEL_DEEP=openai/gpt-6.1-sol
SMARTLEAD_API_KEY=your_smartlead_api_key_here
WEBHOOK_BASE_URL=https://yourapp.com  # ngrok URL for dev
MILLIONVERIFIER_API_KEY=your_millionverifier_api_key_here
